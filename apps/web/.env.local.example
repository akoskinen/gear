# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > (add a Web app if none exists) > SDK setup and configuration
# Or run: firebase apps:sdkconfig web --project efoilracingprofiles
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=efoilracingprofiles.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=efoilracingprofiles
VITE_FIREBASE_STORAGE_BUCKET=efoilracingprofiles.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 1 to point the app at the local Firebase emulators instead of the live project.
VITE_USE_EMULATORS=0
